# --- Database (Neon / any Postgres 14+) ----------------------------------
# btree_gist must be available — the no-double-booking constraint needs it.
DATABASE_URL="postgresql://user:pass@host/supreme?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host/supreme?sslmode=require"

# --- Twilio ---------------------------------------------------------------
# A Messaging Service SID is REQUIRED; a bare `from` number cannot schedule.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_STATUS_WEBHOOK_URL="https://supremebarbershop.ca/api/twilio/status"

# --- Rate limiting (optional; falls back to in-process memory) -------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://supremebarbershop.ca"
CRON_SECRET=""
